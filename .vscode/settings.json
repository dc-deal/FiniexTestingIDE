{
    // globales Autosave-Format
    "editor.formatOnSave": true,
    "editor.formatOnPaste": true,
    // Python wird NICHT automatisch formatiert, und das ist eine Entscheidung.
    //
    // Vorher stand hier autopep8 als defaultFormatter. Es war nie im Container
    // installiert - haette man es mitinstalliert, haette formatOnSave oben jede
    // gespeicherte Datei auf 79 Spalten umgebrochen, waehrend ruff.toml 100 deklariert.
    //
    // ruff ist auch nicht der Ersatz dafuer: "ruff format" ist ein vollstaendiger
    // Black-artiger Formatter, der Zeilenumbrueche neu setzt und Aufrufe ueber mehrere
    // Zeilen aufspreizt. Das waere eine eigene Grundsatzentscheidung ueber den
    // Layout-Standard des Projekts und ist bewusst nicht getroffen.
    //
    // ruff laeuft hier als LINTER: Verstoesse gegen ruff.toml erscheinen beim Tippen,
    // ohne dass irgendetwas umgeschrieben wird. Geschrieben wird nur im
    // Release-Hygiene-Durchgang, mit ausgewaehlten Regeln und je eigenem Commit.
    "[python]": {
        "editor.formatOnSave": false
    },
    // aus der exporer view ausschliessen
    "files.exclude": {
        "**/__pycache__": true,
        "**/*.pyc": true,
        "**/.pytest_cache": true,
        "**/.mypy_cache": true,
        "**/*.egg-info": true,
        "**/htmlcov": true,
        "**/.coverage": true,
        "**/node_modules": true,
        "**/.DS_Store": true
    },
    // aus der suche ausschliessen
    "search.exclude": {
        "**/data/raw": true,
        "**/data/processed": true,
        "**/data/cache": true
    },
    // gitignored files (github_issues/, ISSUE_*, user_configs/ ...) in search + Ctrl+P anzeigen
    "search.useIgnoreFiles": false,
    // Schriftart ändern, damit Emojis die richtige länge haben (wichtig für boxen)
    // ev. herunterladen falls nciht vorhanden https://github.com/microsoft/cascadia-code/releases
    // Terminal
    "terminal.integrated.fontFamily": "Cascadia Code PL",
    // Debug Console
    "debug.console.fontFamily": "Cascadia Code PL",
    // Editor & Output
    "editor.fontFamily": "Cascadia Code PL",
}