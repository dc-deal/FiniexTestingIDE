{
  "version": "1.4.0",
  "description": "FiniexTestingIDE - Application Configuration",
  "development": {
    "dev_mode": false
  },
  "console_logging": {
    "enabled": true,
    "log_level": "INFO",
    "warn_on_parameter_override": true,
    "scenario": {
      "enabled": false,
      "log_level": "WARNING",
      "write_system_info": true
    },
    "summary": {
      "show_global_log": false,
      "detail": true,
      "scenario_detail_threshold": 9
    }
  },
  "file_logging": {
    "enabled": true,
    "log_level": "DEBUG",
    "global_log_dir": "logs/",
    "append_mode": true,
    "run_logs": {
      "simulation": "runs/simulation",
      "live": "runs/live"
    },
    "run_index": "runs/runs_index.parquet",
    "scenario": {
      "enabled": true,
      "log_level": null,
      "file_name_prefix": "scenario"
    },
    "session_logs": {
      "_comment": "Rotated daily session logs of a LIVE run (#357). 0 keeps all; the active day is never touched.",
      "retention_days": 30
    }
  },
  "paths": {
    "data_processed": "data/processed",
    "user_algo_dirs": [
      "user_algos/"
    ],
    "run_ledger": "runs/ledger",
    "run_configs": "run_configs"
  },
  "history": {
    "bar_max_history": 1000,
    "order_history_max": 10000,
    "trade_history_max": 5000
  },
  "api": {
    "_comment": "require_auth false is the rollout state in which tokens may exist while nothing is gated yet - a consumer needs its token before it can start sending the header. Set true once every consumer confirms it sends one.",
    "require_auth": false
  },
  "autotrader": {
    "tick_source": {
      "_comment": "How ticks are DELIVERED. A profile overrides any of these; the mock-only and kraken-only fields sit together because one block per concern beats two that a reader has to join. quote_channel_enabled subscribes to Kraken's ticker channel beside trades, so a live tick carries the real bid/ask it executed against - the same thing an archived tick has carried since collector format 1.6.0.",
      "type": "mock",
      "tick_delay_ms": 0,
      "ws_url": "wss://ws.kraken.com/v2",
      "quote_channel_enabled": true,
      "reconnect_initial_delay_s": 1.0,
      "reconnect_max_delay_s": 60.0,
      "connection_check_interval_s": 30.0,
      "connection_dead_s": 90.0,
      "freeze_after_ticks": 0,
      "freeze_duration_s": 0.0
    },
    "execution": {
      "parallel_workers": false,
      "bar_max_history": 1000,
      "heartbeat_interval_ms": 500,
      "market_data_stale_after_s": 300.0,
      "venue_held_protection": false,
      "order_timeout_seconds": 30.0,
      "venue_read_settle_seconds": 5.0,
      "unresolved_resolution": {
        "_comment": "A write whose answer was lost is never re-sent - it is ASKED about. These numbers pace that read. The budget is separate from broker_transport.connection on purpose: that ladder aborts the session on give-up, and a resolution that ends the run is worse than the state it resolves.",
        "enabled": true,
        "query_after_ms": 500,
        "requery_interval_seconds": 5.0,
        "max_attempts": 12,
        "max_window_seconds": 120.0
      },
      "performance_tracking": {
        "worker_decision_tracking": true
      }
    },
    "clipping_monitor": {
      "report_interval_s": 60.0,
      "strategy": "queue_all",
      "warn_above_ratio": 0.05
    },
    "display": {
      "enabled": true,
      "update_interval_ms": 300
    },
    "order_guard": {
      "cooldown_seconds": 60.0,
      "max_consecutive_rejections": 2,
      "block_stale_market_data": true
    },
    "drift_audit": {
      "enabled": true,
      "fee_threshold_pct": 0.5,
      "volume_threshold_pct": 0.1,
      "price_threshold_pct": 1.0,
      "slippage_threshold_pct": 0.5,
      "log_all": false,
      "sample_rate": 1.0
    },
    "reconciliation": {
      "enabled": true,
      "mode": "alert_only",
      "interval_ticks": 100,
      "min_interval_seconds": 60.0
    },
    "api_monitor": {
      "enabled": true,
      "slow_call_threshold_ms": 3000.0
    },
    "state_persistence": {
      "enabled": true,
      "path": "data/runtime/session_state",
      "save_interval_ticks": 500,
      "save_interval_seconds": 60.0,
      "max_age_trading_days": 5,
      "on_corrupt": "warn_reset",
      "on_stale": "warn_reset"
    },
    "cold_start": {
      "enabled": true,
      "path": "data/runtime/cold_start_state",
      "adoption_mode": "operator_confirm",
      "book_drift_interval_ticks": 500
    },
    "session_end": {
      "orders": "cancel",
      "positions": "leave"
    },
    "capital": {
      "exclusive_account": false
    }
  },
  "backtesting": {
    "execution": {
      "parallel_scenarios": true,
      "max_parallel_scenarios": 99,
      "default_scenario_execution_config": {
        "parallel_workers": false,
        "worker_parallel_threshold_ms": 1.0,
        "adaptive_parallelization": true,
        "performance_tracking": {
          "tick_loop_profiling": true,
          "worker_decision_tracking": false
        },
        "strict_parameter_validation": true,
        "tick_processing_budget_ms": 0.0,
        "heartbeat_interval_ms": 1000
      }
    },
    "default_trade_simulator_config": {
      "balances": {},
      "seeds": {
        "inbound_latency_seed": 42
      },
      "inbound_latency_min_ms": 20,
      "inbound_latency_max_ms": 80
    },
    "monitoring": {
      "enabled": true,
      "tui_refresh_rate_ms": 300,
      "detailed_live_stats": true,
      "detailed_live_stats_threshold": 3,
      "detailed_live_stats_exports": {
        "export_portfolio_stats": false,
        "export_current_bars": false
      },
      "event_tape_size": 5
    },
    "data_validation": {
      "warmup_quality_mode": "standard",
      "allowed_gap_categories": [
        "seamless",
        "short",
        "weekend",
        "holiday"
      ],
      "_comment_admitted_origin_classes": "Which data origins a scenario may READ (#518). Open on purpose until producers stamp an identity and the legacy archive is attested — a scenario reading anything but producer-stamped production data is WARNED about meanwhile, so the refusal can be measured before it is armed. Narrow this list to arm it.",
      "admitted_origin_classes": [
        "production",
        "development",
        "unknown"
      ]
    },
    "paths": {
      "scenario_sets": "configs/scenario_sets",
      "generator_template": "configs/generator/template_scenario_set_header.json",
      "generator_output": "configs/scenario_sets"
    },
    "parameter_optimization": {
      "mount_reuse_enabled": true,
      "villain_abort_enabled": true
    }
  }
}
